+            find_cuda_pip,
+            find_cuda_conda,
+            find_cuda_hardcoded,
+    ]:
+        cuda_bin_path, cuda_inc_dirs, cuda_lib_dirs = f()
+        if cuda_bin_path:
+            return cuda_bin_path, cuda_inc_dirs, cuda_lib_dirs
+
+    warnings.warn("Failed to find CUDA."
+                  " Install CUDA Toolkit (https://developer.nvidia.com/cuda-downloads)"
