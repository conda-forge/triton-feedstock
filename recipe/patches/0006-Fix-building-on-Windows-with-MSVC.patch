From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Sun, 22 Nov 2026 16:59:08 -0500
Subject: [PATCH] Fix building on Windows with MSVC and conda-forge dlfcn-win32

---
 CMakeLists.txt                               | 11 ++++++++---
 setup.py                                     |  5 ++++-
 third_party/nvidia/CMakeLists.txt            |  6 ++++++
 third_party/nvidia/include/cublas_instance.h | 13 +++++++++++++
 4 files changed, 31 insertions(+), 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1713a47..a886454 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -300,6 +300,11 @@ else()
 endif()
 
 include_directories(".")
+if(WIN32)
+  find_package(dlfcn-win32 REQUIRED)
+  get_target_property(DLFCN_INCLUDE_DIRS dlfcn-win32::dl INTERFACE_INCLUDE_DIRECTORIES)
+  include_directories(${DLFCN_INCLUDE_DIRS})
+endif()
 # LLVM/MLIR range comparisons can trigger -Wambiguous-reversed-operator in
 # C++20. Treat these external headers as system includes.
 include_directories(SYSTEM ${MLIR_INCLUDE_DIRS} ${LLVM_INCLUDE_DIRS})
@@ -449,7 +454,7 @@ if(TRITON_BUILD_PYTHON_MODULE)
   set_target_properties(triton PROPERTIES INTERFACE_LINK_LIBRARIES "")
 
   if(WIN32)
-    target_link_libraries(triton PRIVATE ${CMAKE_DL_LIBS})
+    target_link_libraries(triton PRIVATE dlfcn-win32::dl)
     set_target_properties(triton PROPERTIES SUFFIX ".pyd")
     set_target_properties(triton PROPERTIES PREFIX "lib")
   else()
@@ -483,8 +488,8 @@ if(TRITON_BUILD_PYTHON_MODULE)
   endif()
 
   configure_file(
-    "${LLVM_SYSPATH}/bin/FileCheck"
-    "${TRITON_WHEEL_DIR}/FileCheck"
+    "${LLVM_SYSPATH}/bin/FileCheck${CMAKE_EXECUTABLE_SUFFIX}"
+    "${TRITON_WHEEL_DIR}/FileCheck${CMAKE_EXECUTABLE_SUFFIX}"
     COPYONLY)
 
   # Install Triton headers and TableGen definitions into the wheel staging
diff --git a/setup.py b/setup.py
index 7a12082..66208d9 100644
--- a/setup.py
+++ b/setup.py
@@ -386,7 +386,10 @@ class CMakeBuild(build_ext):
         env = os.environ.copy()
         cmake_dir = get_cmake_dir()
         subprocess.check_call(["cmake", self.base_dir] + cmake_args, cwd=cmake_dir, env=env)
-        update_symlink(Path(self.base_dir) / "compile_commands.json", cmake_dir / "compile_commands.json")
+        try:
+            update_symlink(Path(self.base_dir) / "compile_commands.json", cmake_dir / "compile_commands.json")
+        except OSError as e:
+            print(f"could not symlink compile_commands.json: {e}", file=sys.stderr)
         subprocess.check_call(["cmake", "--build", "."] + build_args, cwd=cmake_dir)
         subprocess.check_call(["cmake", "--build", ".", "--target", "mlir-doc"], cwd=cmake_dir)
         if check_env_flag("TRITON_EXT_ENABLED"):
diff --git a/third_party/nvidia/CMakeLists.txt b/third_party/nvidia/CMakeLists.txt
index ba831b7..7583a2b 100644
--- a/third_party/nvidia/CMakeLists.txt
+++ b/third_party/nvidia/CMakeLists.txt
@@ -18,6 +18,11 @@ if(TRITON_BUILD_PYTHON_MODULE)
     endif()
 
     set(TRITON_GSAN_INCLUDE_FLAGS "")
+    set(TRITON_GSAN_HOST_FLAGS "")
+    if(WIN32)
+      # the device runtime expects the Itanium bitfield layout
+      list(APPEND TRITON_GSAN_HOST_FLAGS --target=x86_64-unknown-linux-gnu)
+    endif()
     foreach(include_path IN ITEMS "${TRITON_CUDACRT_PATH}" "${TRITON_CUDART_PATH}")
       if(NOT "${include_path}" STREQUAL "")
         list(APPEND TRITON_GSAN_INCLUDE_FLAGS "-I${include_path}")
@@ -41,6 +46,7 @@ if(TRITON_BUILD_PYTHON_MODULE)
                 -fcuda-flush-denormals-to-zero
                 --cuda-gpu-arch=sm_80
                 --cuda-feature=+ptx70
+                ${TRITON_GSAN_HOST_FLAGS}
                 ${TRITON_GSAN_INCLUDE_FLAGS}
                 "${GSAN_RUNTIME_SRC}" -o "${GSAN_RUNTIME_IR}"
         DEPENDS "${GSAN_RUNTIME_SRC}" ${GSAN_RUNTIME_HDRS}
diff --git a/third_party/nvidia/include/cublas_instance.h b/third_party/nvidia/include/cublas_instance.h
index 3d69ba1..a8b6570 100644
--- a/third_party/nvidia/include/cublas_instance.h
+++ b/third_party/nvidia/include/cublas_instance.h
@@ -3,6 +3,9 @@
 
 #include "cublas_types.h"
 #include <dlfcn.h>
+#ifndef RTLD_NOLOAD
+#define RTLD_NOLOAD 0
+#endif
 #include <stdexcept>
 #include <string>
 
@@ -41,7 +44,12 @@ private:
       const cublasLtMatrixLayout_t, const cublasLtMatmulAlgo_t *, void *,
       size_t, cudaStream_t);
 
+#ifdef _WIN32
+  static constexpr const char *name = "cublasLt64_13.dll";
+  static constexpr const char *fallbackName = "cublasLt64_12.dll";
+#else
   static constexpr const char *name = "libcublas.so";
+#endif
 
   cublasLtCreate_t cublasLtCreate;
   cublasLtDestroy_t cublasLtDestroy;
@@ -73,6 +81,11 @@ private:
       // If not found, try to load it
       dylibHandle = dlopen(name, RTLD_LOCAL | RTLD_LAZY);
     }
+#ifdef _WIN32
+    if (dylibHandle == nullptr) {
+      dylibHandle = dlopen(fallbackName, RTLD_LOCAL | RTLD_LAZY);
+    }
+#endif
     if (dylibHandle == nullptr) {
       throw std::runtime_error("Could not find `" + std::string(name) +
                                "`. Make sure it is in your "
